mixin header()
	.page-title
		div.page-title-element.menuHolder
			div(class = "menuLinkHolder")
				.menuButton &#8801
				//■ ■ ■
		div.page-title-element.title
			div(class = "lang-section Eng")
				.level1
					a.home(href='/?lang=Eng') Home
				.level1b
					a.projects.is-hidden(href='/projects.html?lang=Eng') &nbsp/ Student&nbsp;projects
				.level2
					a.about.is-hidden(href='/about.html?lang=Eng') &nbsp/ About
					a.links.is-hidden(href='/links.html?lang=Eng') &nbsp/ Links
					a.project-1.is-hidden(href='/project-1.html?lang=Eng') &nbsp/ Project 1
					a.project-2.is-hidden(href='/project-2.html?lang=Eng') &nbsp/ Project 2
					a.project-3.is-hidden(href='/project-3.html?lang=Eng') &nbsp/ Project 3
					a.project-4.is-hidden(href='/project-4.html?lang=Eng') &nbsp/ Project 4
					a.project-5.is-hidden(href='/project-5.html?lang=Eng') &nbsp/ Project 5
				.level3
					a.project-1-slides.is-hidden(href='/project-1-slides.html?lang=Eng') &nbsp/ Slides
					a.project-2-slides.is-hidden(href='/project-2-slides.html?lang=Eng') &nbsp/ Slides
					a.project-3-slides.is-hidden(href='/project-3-slides.html?lang=Eng') &nbsp/ Slides
					a.project-4-slides.is-hidden(href='/project-4-slides.html?lang=Eng') &nbsp/ Slides
					a.project-5-slides.is-hidden(href='/project-5-slides.html?lang=Eng') &nbsp/ Slides
			div(class = "lang-section Esp")
				.level1
					a.home(href='/?lang=Esp') Inicio
				.level1b
					a.projects.is-hidden(href='/projects.html?lang=Esp') &nbsp/ Proyectos&nbsp;de&nbsp;estudiante
				.level2
					a.about.is-hidden(href='/about.html?lang=Esp') &nbsp/ Sobre&nbsp;mí
					a.links.is-hidden(href='/links.html?lang=Esp') &nbsp/ Enlaces
					a.project-1.is-hidden(href='/project-1.html?lang=Esp') &nbsp/ Proyecto 1
					a.project-2.is-hidden(href='/project-2.html?lang=Esp') &nbsp/ Proyecto 2
					a.project-3.is-hidden(href='/project-3.html?lang=Esp') &nbsp/ Proyecto 3
					a.project-4.is-hidden(href='/project-4.html?lang=Esp') &nbsp/ Proyecto 4
					a.project-5.is-hidden(href='/project-5.html?lang=Esp') &nbsp/ Proyecto 5
				.level3
					a.project-1-slides.is-hidden(href='/project-1-slides.html?lang=Esp') &nbsp/ Diapositivas
					a.project-2-slides.is-hidden(href='/project-2-slides.html?lang=Esp') &nbsp/ Diapositivas
					a.project-3-slides.is-hidden(href='/project-3-slides.html?lang=Esp') &nbsp/ Diapositivas
					a.project-4-slides.is-hidden(href='/project-4-slides.html?lang=Esp') &nbsp/ Diapositivas
					a.project-5-slides.is-hidden(href='/project-5-slides.html?lang=Esp') &nbsp/ Diapositivas
		div.page-title-element.menu.hidden
			img.menuBackground(src='/_data/general/menu_BG.png')
			div.menuEntry
				div(class = "lang-section Eng")
					a(href='/projects.html?lang=Eng') Student projects
				div(class = "lang-section Esp")
					a(href='/projects.html?lang=Esp') Proyectos de estudiante
			hr
			div.menuEntry
				div(class = "lang-section Eng")
					a(href='/about.html?lang=Eng') About
				div(class = "lang-section Esp")
					a(href='/about.html?lang=Esp') Sobre mí
			hr
			div.menuEntry
				div(class = "lang-section Eng")
					a(href='/links.html?lang=Eng') Links
				div(class = "lang-section Esp")
					a(href='/links.html?lang=Esp') Enlaces
			hr
			div.menuEntry.lang
				.lang-element-holder
					.lang-element.Eng.active Eng
					|  / 
					.lang-element.Esp Esp

