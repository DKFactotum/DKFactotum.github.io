include ../1-base/_mixins
include ../3-modules/_header
include ../3-modules/_footer

mixin lang-section-about(lang)
	section#about(class = "lang-section "+lang, lang = (lang == "Esp" ? "es" : "en"))
		.wrapper
			.about-content
				.about-element.about-intro
					h2.about-title
						+pull-a(lang+".intro")
					.about-av
						img(src = "/_data/general/avatar.jpg", alt = "Daniil Koshelyuk")
					p.nonCapitalized.justified
						+pull-a(lang+".paragraph")
					p.nonCapitalized.justified.below-picture
						+pull-a(lang+".academia")
					p.nonCapitalized.justified
						+pull-a(lang+".recently")
				.about-element
					p.nonCapitalized.justified
						+pull-a(lang+".extras")
				.about-element.about-invitations
					p.nonCapitalized.centered
						+pull-a(lang+".contact-intro")
					a.link(href='mailto:{{ site.email }}') {{ site.email }}


.page-wrapper.load
	.content-wrapper.load#about
		+header
		+lang-section-about("Eng")
		+lang-section-about("Esp")
		//- +footer
